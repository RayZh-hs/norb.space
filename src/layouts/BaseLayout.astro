---
import { ThemeProvider } from 'astro-pure/components/basic'
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import MinimalHeader from '@/components/MinimalHeader.astro'
import MinimalFooter from '@/components/MinimalFooter.astro'
import InversionCursor from '@/components/InversionCursor.astro'
import config from '@/site-config'

import '@/assets/styles/app.css'

interface Props {
  meta: SiteMeta
  highlightColor?: string
  showHighlightGradient?: boolean
  fullBleed?: boolean
  floatingHeader?: boolean
  transparentHeader?: boolean
  hideBrandInitially?: boolean
  hideFooter?: boolean
  enableCursor?: boolean
  disableSmoothScroll?: boolean
}

const {
  meta: { articleDate, description = config.description, ogImage, title },
  highlightColor = '#5e81ac',
  showHighlightGradient = false,
  fullBleed = false,
  floatingHeader = false,
  transparentHeader = false,
  hideBrandInitially = false,
  hideFooter = false,
  enableCursor = false,
  disableSmoothScroll = false
} = Astro.props
---

<html lang={config.locale.lang}>
  <head>
    <BaseHead {articleDate} {description} {ogImage} {title} />
    <ThemeProvider />
  </head>

  <body
    data-enable-cursor={enableCursor ? 'true' : 'false'}
    data-smooth-scroll={disableSmoothScroll ? 'off' : 'on'}
    class:list={[
      'relative min-h-screen bg-background text-foreground antialiased selection:bg-foreground selection:text-background',
      enableCursor && 'has-inversion-cursor'
    ]}
  >
    {
      showHighlightGradient && (
        <div
          id='highlight-gradient'
          class='pointer-events-none absolute inset-x-0 top-0 z-0 h-screen w-full opacity-25 transition-opacity duration-500'
          style={`background-image: linear-gradient(${highlightColor}, transparent);`}
          aria-hidden='true'
        />
      )
    }

    <MinimalHeader
      floating={floatingHeader}
      transparent={transparentHeader}
      invertedAware={floatingHeader}
      hideBrandInitially={hideBrandInitially}
    />

    <div class='page-transition-shell relative'>
      {
        fullBleed ? (
          <slot />
        ) : (
          <div class='mx-auto w-full max-w-[78rem] px-6 pt-7 sm:px-10'>
            <slot />
          </div>
        )
      }
    </div>

    {!hideFooter && <MinimalFooter />}
    <InversionCursor />

    <script>
      import { destroySmoothScroll, initSmoothScroll } from '@/lib/smooth-scroll'

      function setupPageSmoothScroll() {
        initSmoothScroll({ damping: 13.5, wheelMultiplier: 1.1 })
      }

      document.addEventListener('astro:before-swap', () => {
        destroySmoothScroll()
        document.body.classList.remove('home-inverted')
      })

      document.addEventListener('astro:page-load', setupPageSmoothScroll)
    </script>

    <style define:vars={{ highlightColor }}>
      :global(.highlight) {
        color: var(--highlightColor, hsl(var(--primary) / var(--un-text-opacity))) !important;
      }
      :global(.highlight-bg) {
        background-color: var(
          --highlightColor,
          hsl(var(--primary) / var(--un-text-opacity))
        ) !important;
      }
    </style>
  </body>
</html>
