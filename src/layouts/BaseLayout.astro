---
import { ThemeProvider } from 'astro-pure/components/basic'
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import MinimalHeader from '@/components/MinimalHeader.astro'
import MinimalFooter from '@/components/MinimalFooter.astro'
import InversionCursor from '@/components/InversionCursor.astro'
import config from '@/site-config'

import '@/assets/styles/app.css'

interface Props {
  meta: SiteMeta
  highlightColor?: string
  fullBleed?: boolean
  floatingHeader?: boolean
  hideFooter?: boolean
  enableCursor?: boolean
}

const {
  meta: { articleDate, description = config.description, ogImage, title },
  highlightColor = '#5e81ac',
  fullBleed = false,
  floatingHeader = false,
  hideFooter = false,
  enableCursor = false
} = Astro.props
---

<html lang={config.locale.lang}>
  <head>
    <BaseHead {articleDate} {description} {ogImage} {title} />
    <ThemeProvider />
  </head>

  <body
    class:list={[
      'min-h-screen bg-background text-foreground antialiased selection:bg-foreground selection:text-background',
      enableCursor && 'has-inversion-cursor'
    ]}
  >
    <MinimalHeader floating={floatingHeader} invertedAware={floatingHeader} />

    {
      fullBleed ? (
        <slot />
      ) : (
        <div class='mx-auto w-full max-w-[74rem] px-5 pt-8 sm:px-8'>
          <slot />
        </div>
      )
    }

    {!hideFooter && <MinimalFooter />}
    {enableCursor && <InversionCursor />}

    <style define:vars={{ highlightColor }}>
      :global(.highlight) {
        color: var(--highlightColor, hsl(var(--primary) / var(--un-text-opacity))) !important;
      }
      :global(.highlight-bg) {
        background-color: var(
          --highlightColor,
          hsl(var(--primary) / var(--un-text-opacity))
        ) !important;
      }
    </style>
  </body>
</html>
