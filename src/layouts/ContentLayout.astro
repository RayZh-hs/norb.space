---
import { BackToTop } from 'astro-pure/components/pages'
import type { SiteMeta } from 'astro-pure/types'
import { Button } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'

interface Props {
  meta: SiteMeta
  highlightColor?: string
  back?: string
  useSidebar?: boolean
  showReadingProgress?: boolean
}

const {
  meta,
  highlightColor,
  back = '/',
  useSidebar = true,
  showReadingProgress = false,
  ...props
} = Astro.props
---

<PageLayout
  {meta}
  {highlightColor}
  showHighlightGradient={true}
  transparentHeader={true}
  enableCursor={false}
  {...props}
>
  {
    showReadingProgress && (
      <div class='reading-progress-bar' aria-hidden='true'>
        <div id='reading-progress-fill' class='reading-progress-fill' />
      </div>
    )
  }

  <Button title='Back' href={back} style='back' />

  <main class='mt-6 items-start gap-x-10 md:flex'>
    {/* Sidebar */}
    {
      useSidebar && (
        <aside
          class='animate top-20 min-w-48 basis-60 overflow-y-auto max-md:hidden md:sticky md:order-1 lg:shrink-0'
          style='max-height:calc(100vh - 7rem); scrollbar-width: thin;'
          id='sidebar'
        >
          <slot name='sidebar' />
        </aside>
      )
    }

    <article class='min-w-0 grow'>
      {/* Content header */}
      <div id='content-header' class='animate'>
        <slot name='header' />
      </div>

      {/* Content */}
      <div
        id='content'
        class={cn('blog-prose max-w-none animate mt-8 md:min-w-[45ch]', integ.typography.class)}
      >
        <slot />
      </div>
    </article>
  </main>

  <div class='bottom mt-6 items-start gap-x-10 md:flex'>
    {/* Bottom */}
    <div class='mt-8 flex-1 text-muted-foreground md:min-w-[50ch]'>
      <slot name='bottom' />
    </div>
    {
      useSidebar && (
        <div class='min-w-48 basis-60 max-md:hidden'>
          <slot name='bottom-sidebar' />
        </div>
      )
    }
  </div>

  <BackToTop header='content-header' content='content' />
</PageLayout>

<style is:global>
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 60;
    background: transparent;
    pointer-events: none;
  }
  .reading-progress-fill {
    width: 100%;
    height: 100%;
    background: var(--highlightColor, hsl(var(--foreground)));
    opacity: 0.72;
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 0.08s linear;
  }
  .blog-prose h2,
  .blog-prose h3 {
    letter-spacing: -0.02em;
  }
  .blog-prose a {
    text-underline-offset: 4px;
  }
</style>

{
  showReadingProgress && (
    <script>
      let progressCleanup: (() => void) | null = null

      function initReadingProgress() {
        if (progressCleanup) {
          progressCleanup()
          progressCleanup = null
        }
        const fill = document.getElementById('reading-progress-fill')
        const content = document.getElementById('content')
        if (!fill || !content) return

        const update = () => {
          const rect = content.getBoundingClientRect()
          const total = Math.max(1, content.offsetHeight - window.innerHeight * 0.65)
          const scrolled = Math.max(0, Math.min(total, -rect.top + window.innerHeight * 0.2))
          fill.style.transform = `scaleX(${(scrolled / total).toFixed(4)})`
        }
        window.addEventListener('scroll', update, { passive: true })
        window.addEventListener('resize', update, { passive: true })
        update()

        progressCleanup = () => {
          window.removeEventListener('scroll', update)
          window.removeEventListener('resize', update)
        }
      }

      document.addEventListener('astro:before-swap', () => {
        if (progressCleanup) {
          progressCleanup()
          progressCleanup = null
        }
      })
      document.addEventListener('astro:page-load', initReadingProgress)
    </script>
  )
}
