---
import config from '@/site-config'

interface Props {
  floating?: boolean
  invertedAware?: boolean
}

const { floating = false, invertedAware = false } = Astro.props
const pathname = Astro.url.pathname

const navItems = [
  { title: 'Home', link: '/' },
  { title: 'Blog', link: '/blog' },
  { title: 'Projects', link: '/projects' }
]

function isActive(link: string) {
  if (link === '/') return pathname === '/'
  return pathname === link || pathname.startsWith(link + '/')
}
---

<header
  id='site-header'
  class:list={[
    'site-header z-40 transition-all duration-300',
    floating
      ? 'fixed inset-x-0 top-0 px-6 py-5 sm:px-10'
      : 'sticky top-0 border-b border-border/60 bg-background/85 backdrop-blur-md',
    invertedAware && 'header-invert-aware'
  ]}
>
  <div
    class:list={[
      'mx-auto flex items-center justify-between',
      floating ? 'max-w-[90rem]' : 'max-w-[74rem] px-5 py-4 sm:px-8'
    ]}
  >
    <a
      href='/'
      aria-label={config.title}
      class='group inline-flex items-center gap-2.5 text-base font-medium tracking-[-0.02em] text-current no-underline'
      data-cursor='link'
    >
      <span
        class='inline-block size-2.5 rounded-full border-[1.75px] border-current transition-transform duration-300 group-hover:scale-125'
        aria-hidden='true'
      ></span>
      <span>Norb</span>
    </a>

    <nav aria-label='Primary' class='flex items-center gap-1 sm:gap-2'>
      {
        navItems.map((item) => (
          <a
            href={item.link}
            data-cursor='link'
            aria-current={isActive(item.link) ? 'page' : undefined}
            class:list={[
              'nav-link relative px-3 py-1.5 text-sm tracking-[-0.01em] transition-opacity duration-200 no-underline',
              isActive(item.link)
                ? 'font-medium opacity-100'
                : 'opacity-55 hover:opacity-100'
            ]}
          >
            {item.title}
            {isActive(item.link) && (
              <span
                class='absolute inset-x-3 -bottom-0.5 h-[1.5px] bg-current'
                aria-hidden='true'
              />
            )}
          </a>
        ))
      }

      <span class='mx-1.5 hidden h-3.5 w-px bg-current opacity-15 sm:inline-block' aria-hidden='true'></span>

      <a
        href='/search'
        aria-label='Search'
        title='Search'
        data-cursor='link'
        class='inline-flex size-8 items-center justify-center rounded-full opacity-55 transition-opacity hover:opacity-100'
      >
        <svg class='size-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.75' stroke-linecap='round' stroke-linejoin='round'>
          <circle cx='11' cy='11' r='7'></circle>
          <path d='m20 20-3.5-3.5'></path>
        </svg>
      </a>

      <button
        id='minimal-theme-toggle'
        type='button'
        aria-label='Toggle color theme'
        title='Toggle color theme'
        data-cursor='link'
        class='inline-flex size-8 items-center justify-center rounded-full opacity-60 transition-opacity hover:opacity-100'
      >
        <svg class='theme-icon-sun hidden size-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.75' stroke-linecap='round' stroke-linejoin='round'>
          <circle cx='12' cy='12' r='4'></circle>
          <path d='M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41'></path>
        </svg>
        <svg class='theme-icon-moon hidden size-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.75' stroke-linecap='round' stroke-linejoin='round'>
          <path d='M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z'></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    color: hsl(var(--foreground));
  }
  .site-header a:hover {
    color: currentColor;
  }
  :global(html.dark) #minimal-theme-toggle .theme-icon-sun {
    display: block;
  }
  :global(html:not(.dark)) #minimal-theme-toggle .theme-icon-moon {
    display: block;
  }
</style>

<script>
  const btn = document.getElementById('minimal-theme-toggle')
  btn?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark')
    const next = isDark ? 'light' : 'dark'
    localStorage.setItem('theme', next)
    document.documentElement.classList.toggle('dark', next === 'dark')
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', next === 'dark' ? '#0b0b0b' : '#fafafa')
    window.dispatchEvent(new CustomEvent('norb:theme-change', { detail: { theme: next } }))
  })
</script>
