---
import config from '@/site-config'

interface Props {
  floating?: boolean
  transparent?: boolean
  invertedAware?: boolean
  hideBrandInitially?: boolean
}

const {
  floating = false,
  transparent = false,
  invertedAware = false,
  hideBrandInitially = false
} = Astro.props
const pathname = Astro.url.pathname

const navItems = [
  { title: 'Home', link: '/' },
  { title: 'Blog', link: '/blog' },
  { title: 'Projects', link: '/projects' },
  { title: 'Creative', link: '/creative' }
]

function isActive(link: string) {
  if (link === '/') return pathname === '/'
  return pathname === link || pathname.startsWith(link + '/')
}
---

<header
  id='site-header'
  transition:name='site-header'
  class:list={[
    'site-header z-40 border-b transition-[background-color,border-color,color] duration-300',
    floating
      ? 'fixed inset-x-0 top-0 border-transparent bg-transparent'
      : transparent
        ? 'sticky top-0 border-transparent bg-transparent'
        : 'sticky top-0 border-border/50 bg-background/80 backdrop-blur-md',
    transparent && 'header-transparent',
    invertedAware && 'header-invert-aware'
  ]}
>
  <div class='mx-auto flex h-16 w-full max-w-[78rem] items-center justify-between px-6 sm:px-10'>
    <a
      id='header-brand-link'
      href='/'
      aria-label={config.title}
      data-hide-initially={hideBrandInitially ? 'true' : 'false'}
      class:list={[
        'header-brand-link group inline-flex items-baseline text-base leading-none tracking-[-0.025em] text-current no-underline',
        hideBrandInitially && 'is-brand-hidden'
      ]}
      data-cursor='link'
    >
      <span id='header-brand-norb' class='header-brand-norb font-semibold'>Norb</span><span
        id='header-brand-suffix'
        class='header-brand-suffix font-normal opacity-75'
      >'s Space</span>
    </a>

    <nav aria-label='Primary' class='flex items-center gap-1 sm:gap-2'>
      {
        navItems.map((item) => (
          <a
            href={item.link}
            data-cursor='link'
            aria-current={isActive(item.link) ? 'page' : undefined}
            class:list={[
              'nav-link relative px-3 py-1.5 text-sm tracking-[-0.01em] transition-opacity duration-200 no-underline',
              isActive(item.link)
                ? 'font-medium opacity-100'
                : 'opacity-55 hover:opacity-100'
            ]}
          >
            {item.title}
            {isActive(item.link) && (
              <span
                class='absolute inset-x-3 -bottom-0.5 h-[1.5px] bg-current'
                aria-hidden='true'
              />
            )}
          </a>
        ))
      }

      <span class='mx-1.5 hidden h-3.5 w-px bg-current opacity-15 sm:inline-block' aria-hidden='true'></span>

      <button
        id='header-site-search'
        type='button'
        data-search-open='site'
        aria-label='Search site'
        title='Search site (⌘K)'
        data-cursor='link'
        class='inline-flex size-8 items-center justify-center rounded-full opacity-55 transition-opacity hover:opacity-100'
      >
        <svg class='size-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.75' stroke-linecap='round' stroke-linejoin='round'>
          <circle cx='11' cy='11' r='7'></circle>
          <path d='m20 20-3.5-3.5'></path>
        </svg>
      </button>

      <button
        id='minimal-theme-toggle'
        type='button'
        aria-label='Toggle color theme'
        title='Toggle color theme'
        data-cursor='link'
        class='inline-flex size-8 items-center justify-center rounded-full opacity-60 transition-opacity hover:opacity-100'
      >
        <svg class='theme-icon-sun hidden size-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.75' stroke-linecap='round' stroke-linejoin='round'>
          <circle cx='12' cy='12' r='4'></circle>
          <path d='M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41'></path>
        </svg>
        <svg class='theme-icon-moon hidden size-4' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.75' stroke-linecap='round' stroke-linejoin='round'>
          <path d='M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z'></path>
        </svg>
      </button>

      <a
        href='https://github.com/RayZh-hs'
        target='_blank'
        rel='noopener noreferrer'
        aria-label='GitHub profile'
        title='GitHub'
        data-cursor='link'
        class='inline-flex size-8 items-center justify-center rounded-full opacity-55 transition-opacity hover:opacity-100'
      >
        <svg class='size-4' viewBox='0 0 24 24' fill='currentColor' aria-hidden='true'>
          <path d='M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z'></path>
        </svg>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    color: hsl(var(--foreground));
  }
  .site-header a:hover {
    color: currentColor;
  }
  .header-brand-link {
    white-space: nowrap;
    transition: opacity 0.25s ease;
  }
  .header-brand-link.is-brand-hidden {
    opacity: 0;
    pointer-events: none;
  }
  .header-brand-norb,
  .header-brand-suffix {
    display: inline-block;
  }
  .site-header.header-transparent.is-scrolled {
    background-color: hsl(var(--background) / 0.78);
    backdrop-filter: blur(14px);
    border-bottom-color: hsl(var(--border) / 0.45);
  }
  :global(html.dark) #minimal-theme-toggle .theme-icon-sun {
    display: block;
  }
  :global(html:not(.dark)) #minimal-theme-toggle .theme-icon-moon {
    display: block;
  }
</style>

<script>
  let headerScrollHandler: (() => void) | null = null
  let isThemeTransitioning = false

  function applyTheme(next: 'light' | 'dark') {
    localStorage.setItem('theme', next)
    document.documentElement.classList.toggle('dark', next === 'dark')
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', next === 'dark' ? '#0b0b0b' : '#fafafa')
    window.dispatchEvent(new CustomEvent('norb:theme-change', { detail: { theme: next } }))
  }

  function toggleThemeWithCursorExpansion(e: MouseEvent, btn: HTMLButtonElement) {
    if (isThemeTransitioning) return
    const isDark = document.documentElement.classList.contains('dark')
    const next: 'light' | 'dark' = isDark ? 'light' : 'dark'
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    if (prefersReduced) {
      applyTheme(next)
      return
    }

    const cursorApi = window.__norbCursor
    const cursorState = cursorApi?.getState()
    const btnRect = btn.getBoundingClientRect()

    // Anchor expansion at the live cursor circle center when visible, else click/button center
    let cx = btnRect.left + btnRect.width * 0.5
    let cy = btnRect.top + btnRect.height * 0.5
    let startRadius = 0

    if (cursorState && cursorState.enabled && cursorState.visible && cursorState.x >= 0) {
      cx = cursorState.x
      cy = cursorState.y
      startRadius = Math.max(8, cursorState.radius)
    } else if (e.clientX > 0 || e.clientY > 0) {
      cx = e.clientX
      cy = e.clientY
    }

    const maxRadius =
      Math.hypot(
        Math.max(cx, window.innerWidth - cx),
        Math.max(cy, window.innerHeight - cy)
      ) + 16

    const docWithVT = document as Document & {
      startViewTransition?: (cb: () => void) => {
        ready: Promise<void>
        finished: Promise<void>
      }
    }

    if (typeof docWithVT.startViewTransition === 'function') {
      isThemeTransitioning = true
      document.documentElement.classList.add('theme-transitioning')
      cursorApi?.hideForTransition()

      const transition = docWithVT.startViewTransition(() => {
        applyTheme(next)
      })

      transition.ready
        .then(() => {
          document.documentElement.animate(
            {
              clipPath: [
                `circle(${startRadius.toFixed(1)}px at ${cx.toFixed(1)}px ${cy.toFixed(1)}px)`,
                `circle(${maxRadius.toFixed(1)}px at ${cx.toFixed(1)}px ${cy.toFixed(1)}px)`
              ]
            },
            {
              duration: 580,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
              pseudoElement: '::view-transition-new(root)'
            }
          )
        })
        .catch(() => {
          // Ignore aborted view transitions
        })

      transition.finished.finally(() => {
        document.documentElement.classList.remove('theme-transitioning')
        cursorApi?.reemergeAfterTransition()
        isThemeTransitioning = false
      })
    } else if (cursorApi) {
      isThemeTransitioning = true
      cursorApi.runFallbackExpansion(
        cx,
        cy,
        () => applyTheme(next),
        () => {
          isThemeTransitioning = false
        }
      )
    } else {
      applyTheme(next)
    }
  }

  function initHeader() {
    const btn = document.getElementById('minimal-theme-toggle') as HTMLButtonElement | null
    if (btn && btn.dataset.bound !== '1') {
      btn.dataset.bound = '1'
      btn.addEventListener('click', (e) => toggleThemeWithCursorExpansion(e, btn))
    }

    if (headerScrollHandler) {
      window.removeEventListener('scroll', headerScrollHandler)
      headerScrollHandler = null
    }

    const header = document.getElementById('site-header')
    if (header?.classList.contains('header-transparent')) {
      headerScrollHandler = () => {
        header.classList.toggle('is-scrolled', window.scrollY > 28)
      }
      window.addEventListener('scroll', headerScrollHandler, { passive: true })
      headerScrollHandler()
    }
  }

  document.addEventListener('astro:page-load', initHeader)
</script>
