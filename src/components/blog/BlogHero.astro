---
import { getImage } from 'astro:assets'
import type { CollectionEntry, InferEntrySchema } from 'astro:content'
import { PageInfo } from 'astro-pure/components/pages'
import { FormattedDate, Icon } from 'astro-pure/user'
import { getProjectUrl } from '@/lib/content-links'

interface Props {
  data: InferEntrySchema<'blog'>
  remarkPluginFrontmatter: Record<string, unknown>
  hostProject?: CollectionEntry<'projects'> | null
}

const {
  data: {
    title,
    description,
    draft,
    heroImage,
    publishDate,
    updatedDate,
    comment: enableComment,
    tags,
    language
  },
  remarkPluginFrontmatter,
  hostProject = null
} = Astro.props

const hostUrl = hostProject ? getProjectUrl(hostProject) : null
const dateTimeOptions: Intl.DateTimeFormatOptions = {
  month: 'short'
}

// Match the exact 960w/82q WebP generated on /blog so navigating from the index reuses the cached file (0 bytes)
const optimizedHero = heroImage
  ? await getImage({
      src: heroImage.src,
      width: 960,
      format: 'webp',
      quality: 82
    })
  : null
const heroWidth = optimizedHero?.attributes.width ?? heroImage?.width
const heroHeight = optimizedHero?.attributes.height ?? heroImage?.height
---

{
  heroImage && optimizedHero && (
    <div class='hero-image relative mb-6'>
      <img
        src={optimizedHero.src}
        width={heroWidth}
        height={heroHeight}
        alt={heroImage.alt || title}
        class='cover-image relative z-10 h-auto w-full max-w-[65ch] rounded-2xl object-contain'
        fetchpriority='high'
        loading='eager'
        decoding='async'
      />
      <img
        src={optimizedHero.src}
        width={heroWidth}
        height={heroHeight}
        alt=''
        aria-hidden='true'
        loading='eager'
        decoding='async'
        id='blurImage'
        class='pointer-events-none absolute end-0 top-4 z-0 mt-0 h-full max-w-[65ch] rounded-3xl opacity-55 blur-xl transition-opacity duration-300'
      />
    </div>
  )
}

{draft ? <span class='text-red-500'>(Draft)</span> : null}

<div class='article-info max-lg:mx-auto'>
  <div class='flex flex-wrap items-center gap-x-4 gap-y-2 text-xs leading-6 text-muted-foreground'>
    {/* Article date */}
    <div class='flex items-center gap-1'>
      <Icon name='calendar' class='size-5' />
      <FormattedDate class='font-sans' date={publishDate} dateTimeOptions={dateTimeOptions} />
      {
        updatedDate && (
          <div class='flex items-center gap-1'>
            <span> / </span>
            <span>
              Update
              <FormattedDate
                class='font-sans'
                date={updatedDate}
                dateTimeOptions={dateTimeOptions}
              />
            </span>
          </div>
        )
      }
    </div>
    {/* Times read */}
    {
      remarkPluginFrontmatter.minutesRead && (
        <div class='flex items-center gap-1'>
          <Icon name='time' class='size-5' />
          {remarkPluginFrontmatter.minutesRead}
        </div>
      )
    }
    {/* Language */}
    {
      language && (
        <span class='flex items-center gap-1'>
          <Icon name='earth' class='size-5' />
          {language}
        </span>
      )
    }
    {/* Tags */}
    {
      !!tags?.length && (
        <span class='flex items-center gap-1'>
          <Icon name='hashtag' class='size-5' />
          {tags.map((tag: string, i: number) => (
            <div>
              <a
                aria-label={`View more blogs with the tag ${tag}`}
                class='hover:underline hover:underline-offset-4'
                data-pagefind-filter='tag'
                href={`/tags/${tag}`}
              >
                {tag}
              </a>
              {i < tags.length - 1 && '/'}
            </div>
          ))}
        </span>
      )
    }
    {/* Subtle Host Project Link (minimal trace of the new aesthetic) */}
    {
      hostProject && hostUrl && (
        <a
          href={hostUrl}
          class='inline-flex items-center gap-1.5 rounded-full border border-border/70 bg-background/40 px-2.5 py-0.5 text-[11px] font-medium text-foreground/85 no-underline backdrop-blur-sm transition-colors hover:border-foreground/50 hover:text-foreground'
        >
          <span
            class='inline-block size-1.5 rounded-full'
            style={`background-color: ${hostProject.data.gradient.from};`}
            aria-hidden='true'
          />
          <span>{hostProject.data.projectName}</span>
          <span aria-hidden='true'>↗</span>
        </a>
      )
    }
  </div>

  <h1 class='mt-4 text-2xl font-medium tracking-[-0.02em] sm:mb-2 sm:mt-6 sm:text-3xl'>
    {title}
  </h1>

  <div class='mt-3 italic'>
    <blockquote class='text-sm text-muted-foreground'><q>{description}</q></blockquote>
    {!draft && enableComment && <PageInfo class='mt-1' />}
  </div>
</div>

{/* Dividing line */}
<div class='mt-4 w-1/2 border-t max-lg:mx-auto sm:mt-6 sm:w-1/3'></div>

<script>
  let blurScrollCleanup: (() => void) | null = null

  function initHeroBlurFade() {
    if (blurScrollCleanup) {
      blurScrollCleanup()
      blurScrollCleanup = null
    }
    const image = document.getElementById('blurImage') as HTMLImageElement | null
    if (!image) return

    const onScroll = () => {
      const vh = window.innerHeight || 800
      const scrollDistance = window.scrollY
      if (scrollDistance >= (vh * 3) / 9) {
        image.style.opacity = '0.12'
      } else if (scrollDistance >= (vh * 2) / 9) {
        image.style.opacity = '0.28'
      } else if (scrollDistance >= vh / 9) {
        image.style.opacity = '0.42'
      } else {
        image.style.opacity = '0.55'
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true })
    onScroll()
    blurScrollCleanup = () => window.removeEventListener('scroll', onScroll)
  }

  document.addEventListener('astro:before-swap', () => {
    if (blurScrollCleanup) {
      blurScrollCleanup()
      blurScrollCleanup = null
    }
  })
  document.addEventListener('astro:page-load', initHeroBlurFade)
</script>
