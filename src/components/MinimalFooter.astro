---
import config from '@/site-config'

const year = new Date().getFullYear()
---

<footer class='mt-20 border-t border-border/60 py-8 text-xs text-muted-foreground'>
  <div class='mx-auto flex max-w-[74rem] flex-col items-start justify-between gap-4 px-5 sm:flex-row sm:items-center sm:px-8'>
    <div class='flex flex-wrap items-center gap-x-4 gap-y-1'>
      <span class='font-medium text-foreground'>© {year} {config.author}</span>
      <a href='/terms/list' class='transition-colors hover:text-foreground'>Policy</a>
      {
        config.footer.registration && (
          <a
            href={config.footer.registration.url}
            target='_blank'
            rel='noopener noreferrer'
            class='transition-colors hover:text-foreground'
          >
            {config.footer.registration.text}
          </a>
        )
      }
    </div>

    <div class='flex items-center gap-5'>
      <a href='/blog' class='transition-colors hover:text-foreground'>Blog</a>
      <a href='/projects' class='transition-colors hover:text-foreground'>Projects</a>
      <a href='/rss.xml' class='transition-colors hover:text-foreground'>RSS</a>
      <a
        href='https://github.com/RayZh-hs'
        target='_blank'
        rel='noopener noreferrer'
        class='transition-colors hover:text-foreground'
      >
        GitHub ↗
      </a>
    </div>
  </div>
</footer>
