---
import type { GetStaticPaths, Page } from 'astro'
import { getImage } from 'astro:assets'
import { render, type CollectionEntry } from 'astro:content'

import { Paginator } from 'astro-pure/components/pages'
import { getBlogCollection, getUniqueTags, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import { getHostProjectForPost, getProjectMap, getProjectUrl, normalizeProjectSlug } from '@/lib/content-links'
import config from '@/site-config'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const collections = sortMDByDate(await getBlogCollection())
  const uniqueTags = getUniqueTags(collections)
  const collectionsCount = collections.length
  return paginate(collections, {
    pageSize: config.content.blogPageSize,
    props: { uniqueTags, collectionsCount }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  uniqueTags: string[]
  collectionsCount: number
}

const { page, uniqueTags } = Astro.props

const projectMap = await getProjectMap()

const enrichedPosts = await Promise.all(
  page.data.map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post)
    const hostProject = getHostProjectForPost(post, projectMap)
    const hostSlug = hostProject ? normalizeProjectSlug(hostProject) : null
    const optimizedHero = post.data.heroImage
      ? await getImage({
          src: post.data.heroImage.src,
          width: 960,
          format: 'webp',
          quality: 84
        })
      : null

    const d = post.data.publishDate
    const formattedDate = d.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: '2-digit'
    })

    return {
      id: post.id,
      title: post.data.title,
      description: post.data.description,
      date: formattedDate,
      tags: post.data.tags ?? [],
      minutesRead: String(remarkPluginFrontmatter.minutesRead ?? '5 min read'),
      accent: post.data.heroImage?.color ?? '#5e81ac',
      heroSrc: optimizedHero?.src ?? '',
      hostProject: hostProject
        ? {
            slug: hostSlug!,
            name: hostProject.data.projectName,
            url: getProjectUrl(hostProject),
            accent: hostProject.data.gradient.from
          }
        : null
    }
  })
)

const hostProjectsList = Array.from(
  new Map(
    enrichedPosts
      .filter((p) => p.hostProject)
      .map((p) => [p.hostProject!.slug, p.hostProject!])
  ).values()
)

const meta = {
  description: 'Essays and technical notes on research, systems, design, and personal explorations.',
  title: 'Blog'
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: '← Newer',
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: 'Older →',
      url: page.url.next
    }
  })
}

const initialPost = enrichedPosts[0] ?? null
---

<PageLayout {meta} enableCursor={true}>
  <main class='pb-16 pt-6'>
    {/* Balanced Masthead: Title + Hover-Expand Utility Icons + Integrated Filter Ribbon */}
    <header class='border-b border-border/70 pb-7'>
      <div class='flex items-start justify-between gap-6'>
        <div>
          <h1 class='text-4xl font-semibold tracking-[-0.04em] sm:text-5xl lg:text-[3.5rem]'>
            Blogs
          </h1>
          <p class='mt-3 max-w-xl text-base leading-relaxed text-muted-foreground'>
            Writing across research, compilers, tools, and visual craft.
          </p>
        </div>

        {/* Minimalist Icon Actions that smoothly expand to display text on hover */}
        <div class='flex shrink-0 items-center gap-2 pt-1.5'>
          <a
            href='/archives'
            aria-label='Archives'
            data-cursor='link'
            class='blog-utility-pill'
          >
            <svg
              class='size-4 shrink-0'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='1.7'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <rect x='3' y='4' width='18' height='4' rx='1' />
              <path d='M5 8v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8' />
              <path d='M10 12h4' />
            </svg>
            <span class='blog-utility-label'>Archives</span>
          </a>

          <a
            href='/search'
            aria-label='Search'
            data-cursor='link'
            class='blog-utility-pill'
          >
            <svg
              class='size-4 shrink-0'
              viewBox='0 0 24 24'
              fill='none'
              stroke='currentColor'
              stroke-width='1.7'
              stroke-linecap='round'
              stroke-linejoin='round'
              aria-hidden='true'
            >
              <circle cx='11' cy='11' r='7' />
              <path d='m20 20-3.5-3.5' />
            </svg>
            <span class='blog-utility-label'>Search</span>
          </a>
        </div>
      </div>

      {/* Integrated Filter Ribbon (moved up into header for stronger balance) */}
      <div class='mt-7 flex flex-wrap items-center gap-2' id='blog-filter-bar' role='group' aria-label='Filter blog posts'>
        <button
          type='button'
          class='filter-chip is-active'
          data-filter-type='all'
          data-filter-val='all'
          data-cursor='link'
        >
          All
        </button>

        {
          hostProjectsList.map((proj) => (
            <button
              type='button'
              class='filter-chip'
              data-filter-type='project'
              data-filter-val={proj.slug}
              data-cursor='link'
            >
              <span
                class='inline-block size-1.5 rounded-full'
                style={`background-color: ${proj.accent};`}
                aria-hidden='true'
              />
              <span>{proj.name}</span>
            </button>
          ))
        }

        {
          hostProjectsList.length > 0 && uniqueTags.length > 0 && (
            <span class='mx-1 hidden h-3.5 w-px bg-border sm:inline-block' aria-hidden='true' />
          )
        }

        {
          uniqueTags.map((tag) => (
            <button
              type='button'
              class='filter-chip'
              data-filter-type='tag'
              data-filter-val={tag}
              data-cursor='link'
            >
              #{tag}
            </button>
          ))
        }
      </div>
    </header>

    {/* Editorial Split Stage: Clean Index + Sticky Visual Preview */}
    {
      enrichedPosts.length === 0 ? (
        <p class='mt-14 text-muted-foreground'>No posts published yet.</p>
      ) : (
        <div class='mt-10 grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-14'>
          {/* Left: Clean Interactive Index */}
          <section aria-label='Blog entries' class='lg:col-span-7'>
            <ol id='blog-index-list' class='divide-y divide-border/70 border-y border-border/70'>
              {enrichedPosts.map((post, idx) => (
                <li
                  class:list={['blog-ledger-row group relative', idx === 0 && 'is-highlighted']}
                  data-post-idx={idx}
                  data-post-id={post.id}
                  data-post-title={post.title}
                  data-post-desc={post.description}
                  data-post-date={post.date}
                  data-post-read={post.minutesRead}
                  data-post-hero={post.heroSrc}
                  data-post-accent={post.accent}
                  data-post-tags={post.tags.join(',')}
                  data-post-project-slug={post.hostProject?.slug ?? ''}
                  data-post-project-name={post.hostProject?.name ?? ''}
                  data-post-project-url={post.hostProject?.url ?? ''}
                >
                  <div class='py-7 transition-all duration-300 sm:py-8'>
                    <div class='flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted-foreground'>
                      <span>{post.date}</span>
                      <span class='opacity-35'>·</span>
                      <span>{post.minutesRead}</span>
                    </div>

                    <a
                      href={`/blog/${post.id}`}
                      data-astro-prefetch
                      data-cursor='link'
                      class='mt-2.5 block no-underline'
                    >
                      <h2 class='flex items-baseline justify-between gap-4 text-xl font-semibold tracking-[-0.025em] text-foreground transition-transform duration-300 group-hover:translate-x-1 sm:text-2xl'>
                        <span>{post.title}</span>
                        <span class='shrink-0 text-base font-normal opacity-30 transition-all duration-300 group-hover:translate-x-1 group-hover:opacity-100'>
                          →
                        </span>
                      </h2>
                      <p class='mt-2.5 line-clamp-2 text-sm leading-relaxed text-muted-foreground'>
                        {post.description}
                      </p>
                    </a>

                    {
                      (post.hostProject || post.tags.length > 0) && (
                        <div class='mt-4 flex flex-wrap items-center gap-2'>
                          {post.hostProject && (
                            <a
                              href={post.hostProject.url}
                              data-cursor='link'
                              class='inline-flex items-center gap-1.5 rounded-full border border-foreground/20 bg-foreground/[0.03] px-3 py-1 text-xs font-medium text-foreground no-underline transition-all hover:border-foreground hover:bg-foreground hover:text-background'
                            >
                              <span
                                class='inline-block size-1.5 rounded-full'
                                style={`background-color: ${post.hostProject.accent};`}
                                aria-hidden='true'
                              />
                              <span>{post.hostProject.name}</span>
                              <span aria-hidden='true'>↗</span>
                            </a>
                          )}

                          {post.tags.map((tag) => (
                            <button
                              type='button'
                              data-inline-tag={tag}
                              data-cursor='link'
                              class='inline-tag-btn rounded-full border border-border/75 bg-transparent px-2.5 py-0.5 text-xs text-muted-foreground transition-colors hover:border-foreground/50 hover:text-foreground'
                            >
                              #{tag}
                            </button>
                          ))}
                        </div>
                      )
                    }
                  </div>
                </li>
              ))}
            </ol>

            <p id='blog-empty-msg' class='hidden py-14 text-center text-sm text-muted-foreground'>
              No posts match this filter on this page.
            </p>

            <div class='mt-10'>
              <Paginator {...paginationProps} />
            </div>
          </section>

          {/* Right: Sticky Visual Preview Stage (Desktop) */}
          {initialPost && (
            <aside class='hidden lg:col-span-5 lg:block'>
              <div class='sticky top-28'>
                <div class='overflow-hidden rounded-2xl border border-border/70 bg-card/65 transition-colors'>
                  <a
                    id='preview-stage-img-link'
                    href={`/blog/${initialPost.id}`}
                    data-cursor='link'
                    class='relative block aspect-[16/10] w-full overflow-hidden bg-muted/40'
                  >
                    <img
                      id='preview-stage-img'
                      src={initialPost.heroSrc}
                      alt={initialPost.title}
                      class='h-full w-full object-cover transition-all duration-500 ease-out'
                    />
                    <div
                      id='preview-stage-accent'
                      class='pointer-events-none absolute inset-x-0 bottom-0 h-[2px]'
                      style={`background-color: ${initialPost.accent};`}
                    />
                  </a>

                  <div class='p-6'>
                    <div class='flex items-center justify-between text-xs text-muted-foreground'>
                      <span id='preview-stage-date'>{initialPost.date}</span>
                      <span id='preview-stage-read'>{initialPost.minutesRead}</span>
                    </div>

                    <h3
                      id='preview-stage-title'
                      class='mt-3 text-xl font-semibold tracking-[-0.025em] text-foreground'
                    >
                      {initialPost.title}
                    </h3>

                    <p
                      id='preview-stage-desc'
                      class='mt-2.5 text-sm leading-relaxed text-muted-foreground'
                    >
                      {initialPost.description}
                    </p>

                    <div class='mt-6 flex flex-wrap items-center gap-3 border-t border-border/60 pt-5'>
                      <a
                        id='preview-stage-read-link'
                        href={`/blog/${initialPost.id}`}
                        data-cursor='link'
                        class='inline-flex items-center gap-2 rounded-full bg-foreground px-4 py-2 text-xs font-medium text-background no-underline transition-opacity hover:opacity-85'
                      >
                        <span>Read Post</span>
                        <span aria-hidden='true'>→</span>
                      </a>

                      <a
                        id='preview-stage-project-link'
                        href={initialPost.hostProject ? initialPost.hostProject.url : '/projects'}
                        data-cursor='link'
                        class:list={[
                          'inline-flex items-center gap-1.5 rounded-full border border-border px-4 py-2 text-xs font-medium text-foreground no-underline transition-colors hover:border-foreground',
                          !initialPost.hostProject && 'hidden'
                        ]}
                      >
                        <span id='preview-stage-project-label'>
                          {initialPost.hostProject ? `${initialPost.hostProject.name} ↗` : ''}
                        </span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </aside>
          )}
        </div>
      )
    }
  </main>
</PageLayout>

<style>
  .blog-utility-pill {
    display: inline-flex;
    align-items: center;
    height: 2.35rem;
    padding: 0 0.65rem;
    border-radius: 9999px;
    border: 1px solid hsl(var(--border) / 0.8);
    background: hsl(var(--card) / 0.45);
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    overflow: hidden;
    transition:
      border-color 0.25s ease,
      background-color 0.25s ease,
      color 0.25s ease,
      padding 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .blog-utility-pill:hover,
  .blog-utility-pill:focus-visible {
    padding: 0 0.95rem;
    border-color: hsl(var(--foreground) / 0.45);
    background: hsl(var(--foreground) / 0.06);
    color: hsl(var(--foreground));
  }
  .blog-utility-label {
    display: inline-block;
    max-width: 0;
    opacity: 0;
    margin-left: 0;
    white-space: nowrap;
    overflow: hidden;
    transition:
      max-width 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.24s ease,
      margin-left 0.34s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .blog-utility-pill:hover .blog-utility-label,
  .blog-utility-pill:focus-visible .blog-utility-label {
    max-width: 6rem;
    opacity: 1;
    margin-left: 0.45rem;
  }

  .filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.42rem 0.95rem;
    border-radius: 9999px;
    border: 1px solid hsl(var(--border));
    background: transparent;
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.22s ease;
  }
  .filter-chip:hover {
    border-color: hsl(var(--foreground) / 0.5);
    color: hsl(var(--foreground));
  }
  .filter-chip.is-active {
    background: hsl(var(--foreground));
    border-color: hsl(var(--foreground));
    color: hsl(var(--background));
  }
  .blog-ledger-row {
    transition: background-color 0.25s ease;
  }
  .blog-ledger-row.is-highlighted::before {
    content: '';
    position: absolute;
    left: -1.15rem;
    top: 2rem;
    bottom: 2rem;
    width: 2px;
    background: hsl(var(--foreground));
    opacity: 0.75;
  }
  @media (max-width: 1024px) {
    .blog-ledger-row.is-highlighted::before {
      display: none;
    }
  }
</style>

<script>
  function initBlogIndex() {
    const listEl = document.getElementById('blog-index-list')
    if (!listEl) return

    const rows = Array.from(document.querySelectorAll<HTMLLIElement>('.blog-ledger-row'))
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('#blog-filter-bar .filter-chip'))
    const emptyEl = document.getElementById('blog-empty-msg')

    const imgLinkEl = document.getElementById('preview-stage-img-link') as HTMLAnchorElement | null
    const imgEl = document.getElementById('preview-stage-img') as HTMLImageElement | null
    const accentEl = document.getElementById('preview-stage-accent')
    const dateEl = document.getElementById('preview-stage-date')
    const readEl = document.getElementById('preview-stage-read')
    const titleEl = document.getElementById('preview-stage-title')
    const descEl = document.getElementById('preview-stage-desc')
    const readLinkEl = document.getElementById('preview-stage-read-link') as HTMLAnchorElement | null
    const projLinkEl = document.getElementById('preview-stage-project-link') as HTMLAnchorElement | null
    const projLabelEl = document.getElementById('preview-stage-project-label')

    function activateRow(row: HTMLLIElement) {
      rows.forEach((r) => r.classList.toggle('is-highlighted', r === row))
      if (!titleEl) return

      const hero = row.dataset.postHero ?? ''
      if (imgEl && hero) {
        imgEl.style.opacity = '0.35'
        requestAnimationFrame(() => {
          imgEl.src = hero
          imgEl.alt = row.dataset.postTitle ?? ''
          imgEl.style.opacity = '1'
        })
      }
      const postHref = `/blog/${row.dataset.postId}`
      if (imgLinkEl) imgLinkEl.href = postHref
      if (accentEl) accentEl.style.backgroundColor = row.dataset.postAccent ?? '#5e81ac'
      if (dateEl) dateEl.textContent = row.dataset.postDate ?? ''
      if (readEl) readEl.textContent = row.dataset.postRead ?? ''
      titleEl.textContent = row.dataset.postTitle ?? ''
      if (descEl) descEl.textContent = row.dataset.postDesc ?? ''
      if (readLinkEl) readLinkEl.href = postHref

      const pSlug = row.dataset.postProjectSlug ?? ''
      const pName = row.dataset.postProjectName ?? ''
      const pUrl = row.dataset.postProjectUrl ?? ''
      if (projLinkEl && projLabelEl) {
        if (pSlug && pName && pUrl) {
          projLinkEl.classList.remove('hidden')
          projLinkEl.href = pUrl
          projLabelEl.textContent = `${pName} ↗`
        } else {
          projLinkEl.classList.add('hidden')
        }
      }
    }

    rows.forEach((row) => {
      row.addEventListener('mouseenter', () => activateRow(row))
      row.addEventListener('focusin', () => activateRow(row))
    })

    const applyFilter = (type: string, val: string) => {
      chips.forEach((c) => {
        const active = c.dataset.filterType === type && (c.dataset.filterVal ?? '') === val
        c.classList.toggle('is-active', active)
      })

      let visibleCount = 0
      let firstVisible: HTMLLIElement | null = null

      rows.forEach((row) => {
        let match = true
        if (type === 'project') {
          match = row.dataset.postProjectSlug === val
        } else if (type === 'tag') {
          const tags = (row.dataset.postTags ?? '').split(',')
          match = tags.includes(val)
        }
        row.classList.toggle('hidden', !match)
        if (match) {
          visibleCount++
          if (!firstVisible) firstVisible = row
        }
      })

      emptyEl?.classList.toggle('hidden', visibleCount > 0)
      if (firstVisible) activateRow(firstVisible)
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        applyFilter(chip.dataset.filterType ?? 'all', chip.dataset.filterVal ?? 'all')
      })
    })

    document.querySelectorAll<HTMLButtonElement>('.inline-tag-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.inlineTag
        if (tag) applyFilter('tag', tag)
      })
    })
  }

  document.addEventListener('astro:page-load', initBlogIndex)
</script>
