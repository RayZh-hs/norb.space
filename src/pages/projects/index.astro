---
import { getImage } from 'astro:assets'
import { getCollection, type CollectionEntry } from 'astro:content'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import { getRelatedBlogsForProject, isCreativeProject, normalizeProjectSlug } from '@/lib/content-links'

const allProjectsRaw = (await getCollection('projects')).filter((entry) => !isCreativeProject(entry))
allProjectsRaw.sort((a, b) => {
  const orderA = a.data.order ?? Infinity
  const orderB = b.data.order ?? Infinity
  if (orderA !== orderB) return orderA - orderB
  return a.data.projectName.localeCompare(b.data.projectName)
})

const allBlogPosts = sortMDByDate(await getBlogCollection()) as CollectionEntry<'blog'>[]

const projectsData = await Promise.all(
  allProjectsRaw.map(async (entry, idx) => {
    const slug = normalizeProjectSlug(entry)
    const relatedBlogs = getRelatedBlogsForProject(entry, allBlogPosts).map((p) => ({
      id: p.id,
      title: p.data.title,
      date: p.data.publishDate.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short'
      })
    }))

    const iconLight = entry.data.icon
      ? await getImage({ src: entry.data.icon.src, width: 420, format: 'webp' })
      : null
    const iconDark = entry.data.icon?.dark
      ? await getImage({ src: entry.data.icon.dark, width: 420, format: 'webp' })
      : null
    const coverImg = entry.data.cover
      ? await getImage({ src: entry.data.cover, width: 1280, format: 'webp', quality: 86 })
      : null

    const rendered = await entry.render()

    return {
      index: idx,
      slug,
      name: entry.data.projectName,
      description: entry.data.description,
      category: entry.data.category,
      year: entry.data.year ?? '',
      tags: entry.data.tags ?? [],
      gradientFrom: entry.data.gradient.from,
      gradientTo: entry.data.gradient.to,
      iconLightSrc: iconLight?.src ?? '',
      iconDarkSrc: iconDark?.src ?? '',
      iconScale: entry.data.icon?.scale ?? 1,
      coverSrc: coverImg?.src ?? '',
      homepage: entry.data.homepage ?? '',
      demopage: entry.data.demopage ?? '',
      blogpage: entry.data.blogpage ?? '',
      relatedBlogs,
      Content: rendered.Content
    }
  })
)

const categories = ['All', 'Systems & Compilers', 'AI & Vision', 'Tools']

const clientProjects = projectsData.map(({ Content: _c, ...rest }) => rest)

const meta = {
  title: 'Projects',
  description: 'A full-scene showcase of software engineering, compilers, AI research, and systems projects by Norb.'
}
---

<PageLayout
  {meta}
  fullBleed={true}
  floatingHeader={true}
  hideFooter={true}
  enableCursor={true}
  disableSmoothScroll={true}
>
  <main id='projects-stage-app' class='projects-stage-app'>
    {/* Subtle full-bleed ambient wash adapting to each project's palette */}
    <div id='scene-ambient' class='scene-ambient' aria-hidden='true'></div>

    {/* Architectural 3D orbital gyroscope & helical contour backdrop */}
    <canvas id='projects-particle-canvas' class='projects-particle-canvas' aria-hidden='true'></canvas>

    {/* Centered Top Controls: Category Filter Strip + Overview Trigger */}
    <div class='projects-top-controls'>
      <nav id='projects-filter-bar' class='projects-filter-bar' aria-label='Project categories'>
        {
          categories.map((cat) => (
            <button
              type='button'
              class:list={['proj-cat-pill', cat === 'All' && 'is-active']}
              data-category={cat}
              data-cursor='link'
            >
              {cat}
            </button>
          ))
        }
      </nav>

      <button
        id='projects-overview-toggle'
        type='button'
        class='proj-overview-trigger'
        aria-expanded='false'
        data-cursor='link'
      >
        <svg class='size-3.5 shrink-0' viewBox='0 0 16 16' fill='none' stroke='currentColor' stroke-width='1.5'>
          <rect x='1.5' y='1.5' width='5' height='5' rx='1' />
          <rect x='9.5' y='1.5' width='5' height='5' rx='1' />
          <rect x='1.5' y='9.5' width='5' height='5' rx='1' />
          <rect x='9.5' y='9.5' width='5' height='5' rx='1' />
        </svg>
        <span id='projects-overview-label'>Overview</span>
      </button>
    </div>

    {/* Full-Viewport Scenes Stack: Every project occupies the entire scene */}
    <div id='projects-scenes-viewport' class='projects-scenes-viewport'>
      {
        projectsData.map((p, idx) => (
          <section
            class:list={['project-scene', idx === 0 && 'is-active']}
            data-slug={p.slug}
            data-category={p.category}
            aria-hidden={idx === 0 ? 'false' : 'true'}
          >
            <div class='project-scene-inner mx-auto grid w-full max-w-[82rem] grid-cols-1 items-center gap-10 px-6 sm:px-10 lg:grid-cols-12 lg:gap-16'>
              {/* Visual Showcase Half */}
              <div class='project-visual-col lg:col-span-6'>
                {p.coverSrc ? (
                  <div class='project-cover-frame group'>
                    <img
                      src={p.coverSrc}
                      alt={p.name}
                      class='h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]'
                      loading='eager'
                    />
                  </div>
                ) : (
                  <div
                    class='project-emblem-stage'
                    style={`--proj-from: ${p.gradientFrom}; --proj-to: ${p.gradientTo};`}
                  >
                    <div class='project-emblem-glow' aria-hidden='true' />
                    {p.iconLightSrc && (
                      <img
                        src={p.iconLightSrc}
                        alt={p.name}
                        class:list={[
                          'project-emblem-img',
                          p.iconDarkSrc && 'dark:hidden'
                        ]}
                        style={`--icon-scale: ${p.iconScale};`}
                        loading='eager'
                      />
                    )}
                    {p.iconDarkSrc && (
                      <img
                        src={p.iconDarkSrc}
                        alt={p.name}
                        class='project-emblem-img hidden dark:block'
                        style={`--icon-scale: ${p.iconScale};`}
                        loading='eager'
                      />
                    )}
                  </div>
                )}
              </div>

              {/* Editorial Story Half */}
              <div class='project-story-col lg:col-span-6'>
                <div class='flex items-center gap-2.5 text-sm text-muted-foreground'>
                  <span
                    class='inline-block size-2 rounded-full'
                    style={`background-color: ${p.gradientFrom};`}
                    aria-hidden='true'
                  />
                  <span>{p.category}</span>
                  {p.year && (
                    <>
                      <span class='opacity-40'>·</span>
                      <span>{p.year}</span>
                    </>
                  )}
                </div>

                <h1 class='project-title mt-4 text-4xl font-semibold leading-[1.04] tracking-[-0.04em] text-foreground sm:text-5xl lg:text-[3.75rem]'>
                  {p.name}
                </h1>

                <p class='project-desc mt-5 max-w-xl text-base leading-relaxed text-foreground/80 sm:text-lg'>
                  {p.description}
                </p>

                <div class='project-prose mt-5 max-w-xl text-sm leading-[1.8] text-muted-foreground sm:text-[0.95rem]'>
                  <p.Content />
                </div>

                {p.tags.length > 0 && (
                  <div class='project-tags mt-6 flex flex-wrap gap-2'>
                    {p.tags.map((tag) => (
                      <span class='rounded-full border border-border/80 px-3 py-1 text-xs text-muted-foreground'>
                        {tag}
                      </span>
                    ))}
                  </div>
                )}

                {/* Related Blog Notes */}
                {p.relatedBlogs.length > 0 && (
                  <div class='project-related-blogs mt-7 flex flex-col gap-2 border-t border-border/60 pt-5'>
                    {p.relatedBlogs.map((blog) => (
                      <a
                        href={`/blog/${blog.id}`}
                        data-cursor='link'
                        class='group inline-flex items-center justify-between gap-4 rounded-xl border border-border/60 bg-background/45 px-4 py-3 text-sm text-foreground no-underline backdrop-blur-sm transition-all hover:border-foreground/45 hover:bg-background/80'
                      >
                        <div class='flex min-w-0 items-baseline gap-3'>
                          <span class='truncate font-medium'>{blog.title}</span>
                          <span class='shrink-0 text-xs text-muted-foreground'>{blog.date}</span>
                        </div>
                        <span class='shrink-0 text-muted-foreground transition-transform duration-200 group-hover:translate-x-1 group-hover:text-foreground'>
                          →
                        </span>
                      </a>
                    ))}
                  </div>
                )}

                {/* Primary & Secondary Action Links */}
                <div class='project-actions mt-8 flex flex-wrap items-center gap-3'>
                  {p.demopage && (
                    <a
                      href={p.demopage}
                      target={p.demopage.startsWith('/') ? undefined : '_blank'}
                      rel={p.demopage.startsWith('/') ? undefined : 'noopener noreferrer'}
                      data-cursor='link'
                      class='proj-btn-primary'
                    >
                      <span>Live Demo</span>
                      <span aria-hidden='true'>↗</span>
                    </a>
                  )}
                  {p.homepage && (
                    <a
                      href={p.homepage}
                      target='_blank'
                      rel='noopener noreferrer'
                      data-cursor='link'
                      class={p.demopage ? 'proj-btn-secondary' : 'proj-btn-primary'}
                    >
                      <span>GitHub</span>
                      <span aria-hidden='true'>↗</span>
                    </a>
                  )}
                  {p.relatedBlogs.length > 0 ? (
                    <a
                      href={`/blog/${p.relatedBlogs[0].id}`}
                      data-cursor='link'
                      class='proj-btn-secondary'
                    >
                      <span>Read Blog</span>
                      <span aria-hidden='true'>→</span>
                    </a>
                  ) : p.blogpage ? (
                    <a
                      href={p.blogpage}
                      data-cursor='link'
                      class='proj-btn-secondary'
                    >
                      <span>Read Blog</span>
                      <span aria-hidden='true'>→</span>
                    </a>
                  ) : null}
                </div>
              </div>
            </div>
          </section>
        ))
      }
    </div>

    {/* Right-Edge Minimal Project Rail */}
    <aside id='projects-rail' class='projects-rail' aria-label='Project navigation'>
      {
        projectsData.map((p, idx) => (
          <button
            type='button'
            class:list={['proj-rail-btn', idx === 0 && 'is-active']}
            data-rail-slug={p.slug}
            aria-label={`Jump to ${p.name}`}
            data-cursor='link'
          >
            <span class='proj-rail-label'>{p.name}</span>
            <span class='proj-rail-pip' />
          </button>
        ))
      }
    </aside>

    {/* Minimal Bottom Edge Controls */}
    <div class='projects-bottom-bar'>
      <div class='flex items-center gap-3'>
        <span id='projects-scene-counter' class='text-xs tabular-nums text-muted-foreground'>
          1 / {projectsData.length}
        </span>
        <div class='flex items-center gap-1.5'>
          <button
            id='projects-prev-btn'
            type='button'
            class='proj-step-btn'
            aria-label='Previous project'
            data-cursor='link'
          >
            ↑
          </button>
          <button
            id='projects-next-btn'
            type='button'
            class='proj-step-btn'
            aria-label='Next project'
            data-cursor='link'
          >
            ↓
          </button>
        </div>
      </div>
    </div>

    {/* Optional Zoom-Out Overview Overlay */}
    <div id='projects-overview-overlay' class='projects-overview-overlay' aria-hidden='true'>
      <div class='mx-auto flex h-full w-full max-w-[78rem] flex-col px-6 pb-20 pt-32 sm:px-10'>
        <div class='mb-8 flex items-center justify-between'>
          <h2 class='text-2xl font-semibold tracking-[-0.03em] text-foreground sm:text-3xl'>
            All Projects
          </h2>
          <button
            id='projects-overview-close'
            type='button'
            class='proj-step-btn'
            aria-label='Close overview'
            data-cursor='link'
          >
            ✕
          </button>
        </div>

        <div id='projects-overview-grid' class='projects-overview-grid' data-smooth-scroll-ignore>
          {
            projectsData.map((p) => (
              <button
                type='button'
                class='overview-card group'
                data-overview-slug={p.slug}
                data-category={p.category}
                data-cursor='link'
              >
                <div class='overview-card-media'>
                  {p.coverSrc ? (
                    <img
                      src={p.coverSrc}
                      alt={p.name}
                      class='h-full w-full object-cover transition-transform duration-500 group-hover:scale-105'
                      loading='lazy'
                    />
                  ) : (
                    <div
                      class='flex h-full w-full items-center justify-center p-6'
                      style={`background: radial-gradient(circle at 50% 50%, ${p.gradientFrom}22, transparent 72%);`}
                    >
                      {p.iconLightSrc && (
                        <img
                          src={p.iconLightSrc}
                          alt={p.name}
                          class:list={['max-h-14 max-w-14 object-contain', p.iconDarkSrc && 'dark:hidden']}
                          loading='lazy'
                        />
                      )}
                      {p.iconDarkSrc && (
                        <img
                          src={p.iconDarkSrc}
                          alt={p.name}
                          class='hidden max-h-14 max-w-14 object-contain dark:block'
                          loading='lazy'
                        />
                      )}
                    </div>
                  )}
                </div>
                <div class='p-4 text-left'>
                  <div class='flex items-center justify-between gap-2'>
                    <span class='font-medium text-foreground'>{p.name}</span>
                    {p.year && <span class='text-xs text-muted-foreground'>{p.year}</span>}
                  </div>
                  <p class='mt-1 line-clamp-2 text-xs leading-relaxed text-muted-foreground'>
                    {p.description}
                  </p>
                </div>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </main>

  <script
    is:inline
    id='projects-stage-data'
    type='application/json'
    set:html={JSON.stringify(clientProjects)}
  />
</PageLayout>

<style is:global>
  .projects-stage-app {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100svh;
    overflow: hidden;
    background: hsl(var(--background));
  }

  .scene-ambient {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    transition: background 0.85s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.6s ease;
    opacity: 0.9;
  }

  .projects-particle-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100svh;
    z-index: 1;
    pointer-events: none;
  }

  /* Minimal Top Controls (Category Filters + Overview) — reserved non-overlapping header strip */
  .projects-top-controls {
    position: relative;
    z-index: 36;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    width: 100%;
    padding: 4.55rem 1rem 0.75rem;
    pointer-events: none;
  }
  .projects-top-controls > * {
    pointer-events: auto;
  }
  .projects-filter-bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-width: 0;
    max-width: 100%;
    padding: 0.3rem;
    border-radius: 9999px;
    border: 1px solid hsl(var(--border) / 0.65);
    background: hsl(var(--background) / 0.72);
    backdrop-filter: blur(16px);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .projects-filter-bar::-webkit-scrollbar {
    display: none;
  }
  .proj-cat-pill {
    flex-shrink: 0;
    padding: 0.36rem 0.88rem;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: hsl(var(--muted-foreground));
    font-size: 0.78rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  .proj-cat-pill:hover {
    color: hsl(var(--foreground));
  }
  .proj-cat-pill.is-active {
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }

  /* Full-Scene Stage (strictly below top controls) */
  .projects-scenes-viewport {
    position: relative;
    z-index: 10;
    width: 100%;
    flex: 1 1 0%;
    min-height: 0;
    overflow: hidden;
    perspective: 1400px;
  }

  .project-scene {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    padding: 0.75rem 0 4.25rem;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(0, 64px, -120px) rotateY(8deg) scale(0.95);
    filter: blur(6px);
    transition:
      opacity 0.68s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.82s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity, filter;
  }
  .project-scene::-webkit-scrollbar {
    display: none;
  }
  .project-scene-inner {
    margin-block: auto;
    flex-shrink: 0;
  }
  .project-scene.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: translate3d(0, 0, 0) rotateY(0deg) scale(1);
    filter: blur(0px);
    z-index: 3;
  }
  .project-scene.is-before {
    opacity: 0;
    pointer-events: none;
    transform: translate3d(0, -64px, -120px) rotateY(-8deg) scale(0.95);
    filter: blur(6px);
    z-index: 1;
  }
  .project-scene.is-after {
    opacity: 0;
    pointer-events: none;
    transform: translate3d(0, 64px, -120px) rotateY(8deg) scale(0.95);
    filter: blur(6px);
    z-index: 1;
  }

  /* Visual Frames */
  .project-cover-frame {
    aspect-ratio: 16 / 10.5;
    width: 100%;
    overflow: hidden;
    border-radius: 1.35rem;
    border: 1px solid hsl(var(--border) / 0.6);
    background: hsl(var(--muted) / 0.35);
    box-shadow: 0 32px 70px -28px rgba(0, 0, 0, 0.25);
  }
  .dark .project-cover-frame {
    box-shadow: 0 36px 80px -24px rgba(0, 0, 0, 0.72);
  }

  .project-emblem-stage {
    position: relative;
    aspect-ratio: 4 / 3;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 1.5rem;
    border: 1px solid hsl(var(--border) / 0.65);
    background: hsl(var(--card) / 0.55);
    backdrop-filter: blur(18px);
    overflow: hidden;
    box-shadow: 0 32px 72px -30px rgba(0, 0, 0, 0.16);
  }
  .dark .project-emblem-stage {
    box-shadow: 0 36px 84px -26px rgba(0, 0, 0, 0.65);
  }
  .project-emblem-glow {
    position: absolute;
    width: 68%;
    height: 68%;
    border-radius: 9999px;
    background: radial-gradient(circle, var(--proj-from) 0%, var(--proj-to) 48%, transparent 74%);
    opacity: 0.16;
    filter: blur(42px);
    pointer-events: none;
    transition: transform 0.6s ease, opacity 0.6s ease;
  }
  .dark .project-emblem-glow {
    opacity: 0.24;
  }
  .project-emblem-img {
    position: relative;
    z-index: 2;
    max-width: 52%;
    max-height: 52%;
    object-fit: contain;
    transform: scale(var(--icon-scale, 1));
    filter: drop-shadow(0 18px 34px rgba(0, 0, 0, 0.16));
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .project-emblem-stage:hover .project-emblem-img {
    transform: scale(calc(var(--icon-scale, 1) * 1.05));
  }

  .project-prose p {
    margin-bottom: 0.85rem;
  }
  .project-prose p:last-child {
    margin-bottom: 0;
  }

  /* Action Buttons */
  .proj-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.62rem 1.25rem;
    border-radius: 9999px;
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  .proj-btn-primary:hover {
    opacity: 0.86;
    transform: translateY(-1px);
    color: hsl(var(--background));
  }
  .proj-btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.62rem 1.2rem;
    border-radius: 9999px;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background) / 0.55);
    backdrop-filter: blur(10px);
    color: hsl(var(--foreground));
    font-size: 0.84rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.22s ease, transform 0.22s ease;
  }
  .proj-btn-secondary:hover {
    border-color: hsl(var(--foreground));
    transform: translateY(-1px);
    color: hsl(var(--foreground));
  }

  /* Right-Edge Minimal Rail */
  .projects-rail {
    position: fixed;
    right: 1.5rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 30;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.65rem;
    color: hsl(var(--foreground));
  }
  .proj-rail-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.18rem 0.1rem;
    background: transparent;
    border: none;
    color: inherit;
    cursor: pointer;
  }
  .proj-rail-btn.is-hidden {
    display: none;
  }
  .proj-rail-label {
    font-size: 11px;
    opacity: 0;
    transform: translateX(6px);
    transition: opacity 0.22s ease, transform 0.22s ease;
    pointer-events: none;
    white-space: nowrap;
  }
  .proj-rail-btn:hover .proj-rail-label {
    opacity: 0.7;
    transform: translateX(0);
  }
  .proj-rail-pip {
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: currentColor;
    opacity: 0.22;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.25s ease;
  }
  .proj-rail-btn.is-active .proj-rail-pip {
    opacity: 0.92;
    transform: scale(1.7);
  }

  /* Minimal Bottom Edge Controls */
  .projects-bottom-bar {
    position: fixed;
    inset-x: 0;
    bottom: 1.5rem;
    z-index: 30;
    margin: 0 auto;
    max-width: 90rem;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    pointer-events: none;
  }
  @media (min-width: 640px) {
    .projects-bottom-bar {
      padding: 0 2.5rem;
    }
  }
  .projects-bottom-bar > * {
    pointer-events: auto;
  }
  .proj-overview-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    padding: 0.52rem 1rem;
    border-radius: 9999px;
    border: 1px solid hsl(var(--border) / 0.65);
    background: hsl(var(--background) / 0.72);
    backdrop-filter: blur(16px);
    color: hsl(var(--foreground));
    font-size: 0.78rem;
    font-weight: 500;
    white-space: nowrap;
    flex-shrink: 0;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }
  .proj-overview-trigger:hover,
  .proj-overview-trigger.is-open {
    border-color: hsl(var(--foreground));
    background: hsl(var(--foreground));
    color: hsl(var(--background));
  }

  .proj-step-btn {
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 9999px;
    border: 1px solid hsl(var(--border) / 0.8);
    background: hsl(var(--background) / 0.72);
    backdrop-filter: blur(14px);
    color: hsl(var(--foreground));
    font-size: 0.82rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .proj-step-btn:hover {
    background: hsl(var(--foreground));
    color: hsl(var(--background));
    border-color: hsl(var(--foreground));
  }

  /* Zoom-Out Overview Overlay */
  .projects-overview-overlay {
    position: fixed;
    inset: 0;
    z-index: 35;
    background: hsl(var(--background) / 0.92);
    backdrop-filter: blur(22px);
    opacity: 0;
    pointer-events: none;
    transform: scale(1.03);
    transition:
      opacity 0.42s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.48s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .projects-overview-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
  }
  .projects-overview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.15rem;
    overflow-y: auto;
    margin: -0.4rem -0.35rem 0;
    padding: 0.4rem 0.35rem 2rem;
    scrollbar-width: thin;
  }
  .overview-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid hsl(var(--border) / 0.75);
    background: hsl(var(--card) / 0.75);
    cursor: pointer;
    transition: border-color 0.22s ease, transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .overview-card:hover {
    border-color: hsl(var(--foreground) / 0.55);
    transform: translateY(-3px);
  }
  .overview-card.is-active {
    border-color: hsl(var(--foreground));
  }
  .overview-card.is-hidden {
    display: none;
  }
  .overview-card-media {
    aspect-ratio: 16 / 10;
    width: 100%;
    overflow: hidden;
    background: hsl(var(--muted) / 0.35);
  }

  /* Compact Desktop Height Adaptation (laptops & scaled wide screens) */
  @media (min-width: 1025px) and (max-height: 780px) {
    .projects-stage-app .projects-top-controls {
      padding: 4.3rem 1rem 0.5rem;
    }
    .projects-stage-app .project-scene {
      padding: 0.5rem 0 3.75rem;
    }
    .projects-stage-app .project-cover-frame,
    .projects-stage-app .project-emblem-stage {
      max-height: min(420px, calc(100svh - 13.5rem));
    }
    .projects-stage-app .project-title {
      margin-top: 0.65rem;
      font-size: clamp(2.15rem, 5svh, 3.25rem);
    }
    .projects-stage-app .project-desc {
      margin-top: 0.75rem;
      font-size: 0.98rem;
      line-height: 1.5;
    }
    .projects-stage-app .project-prose {
      margin-top: 0.75rem;
      font-size: 0.875rem;
      line-height: 1.6;
    }
    .projects-stage-app .project-prose p {
      margin-bottom: 0.55rem;
    }
    .projects-stage-app .project-tags {
      margin-top: 0.9rem;
    }
    .projects-stage-app .project-related-blogs {
      margin-top: 1rem;
      padding-top: 0.85rem;
    }
    .projects-stage-app .project-actions {
      margin-top: 1.1rem;
    }
  }

  @media (min-width: 1025px) and (max-height: 640px) {
    .projects-stage-app .projects-top-controls {
      padding: 4.15rem 1rem 0.4rem;
    }
    .projects-stage-app .project-scene {
      padding: 0.35rem 0 3.25rem;
    }
    .projects-stage-app .project-cover-frame,
    .projects-stage-app .project-emblem-stage {
      max-height: min(340px, calc(100svh - 12.25rem));
    }
    .projects-stage-app .project-title {
      margin-top: 0.45rem;
      font-size: clamp(1.95rem, 4.6svh, 2.75rem);
    }
    .projects-stage-app .project-desc {
      margin-top: 0.55rem;
      font-size: 0.92rem;
      line-height: 1.45;
    }
    .projects-stage-app .project-prose {
      margin-top: 0.55rem;
      font-size: 0.84rem;
      line-height: 1.52;
    }
    .projects-stage-app .project-prose p {
      margin-bottom: 0.45rem;
    }
    .projects-stage-app .project-tags {
      margin-top: 0.7rem;
    }
    .projects-stage-app .project-related-blogs {
      margin-top: 0.75rem;
      padding-top: 0.65rem;
    }
    .projects-stage-app .project-actions {
      margin-top: 0.85rem;
    }
  }

  /* Responsive Tablet / Mobile */
  @media (max-width: 1024px) {
    .projects-rail {
      display: none;
    }
    .project-scene {
      padding: 0.75rem 0 5.5rem;
    }
    .project-scene-inner {
      margin-block: 0;
    }
    .project-emblem-stage {
      aspect-ratio: 16 / 9;
    }
  }
</style>

<script>
  interface StageProject {
    index: number
    slug: string
    name: string
    description: string
    category: string
    year: string
    gradientFrom: string
    gradientTo: string
  }

  let cleanupProjects: (() => void) | null = null

  function initProjectsStage() {
    if (cleanupProjects) {
      cleanupProjects()
      cleanupProjects = null
    }

    const app = document.getElementById('projects-stage-app')
    const dataEl = document.getElementById('projects-stage-data')
    if (!app || !dataEl) return

    const allProjects: StageProject[] = JSON.parse(dataEl.textContent || '[]')
    if (!allProjects.length) return

    const ambientEl = document.getElementById('scene-ambient')!
    const counterEl = document.getElementById('projects-scene-counter')!
    const prevBtn = document.getElementById('projects-prev-btn')!
    const nextBtn = document.getElementById('projects-next-btn')!
    const overviewBtn = document.getElementById('projects-overview-toggle')!
    const overviewLabel = document.getElementById('projects-overview-label')!
    const overviewOverlay = document.getElementById('projects-overview-overlay')!
    const overviewClose = document.getElementById('projects-overview-close')!

    const catBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#projects-filter-bar .proj-cat-pill'))
    const railBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('#projects-rail .proj-rail-btn'))
    const overviewCards = Array.from(document.querySelectorAll<HTMLButtonElement>('#projects-overview-grid .overview-card'))

    const sceneEls = new Map<string, HTMLElement>()
    document.querySelectorAll<HTMLElement>('.project-scene').forEach((el) => {
      if (el.dataset.slug) sceneEls.set(el.dataset.slug, el)
    })

    let selectedCategory = 'All'
    let filtered: StageProject[] = [...allProjects]
    let currentIdx = 0
    let targetHelixIdx = 0
    let smoothHelixIdx = 0
    let overviewOpen = false
    let wheelCooldown = 0
    let wheelAccum = 0
    let lastWheelAt = 0

    function setOverview(open: boolean) {
      overviewOpen = open
      overviewOverlay.classList.toggle('is-open', open)
      overviewOverlay.setAttribute('aria-hidden', String(!open))
      overviewBtn.classList.toggle('is-open', open)
      overviewBtn.setAttribute('aria-expanded', String(open))
      overviewLabel.textContent = open ? 'Close' : 'Overview'
    }

    function updateAmbient(project: StageProject) {
      const isDark = document.documentElement.classList.contains('dark')
      const a1 = isDark ? '20' : '16'
      const a2 = isDark ? '14' : '0e'
      ambientEl.style.background = `
        radial-gradient(62% 62% at 24% 48%, ${project.gradientFrom}${a1} 0%, transparent 72%),
        radial-gradient(50% 54% at 82% 28%, ${project.gradientTo}${a2} 0%, transparent 74%)
      `
    }

    function renderActiveScene(pushUrl = true) {
      if (!filtered.length) return
      const active = filtered[currentIdx]
      const filteredIndexMap = new Map(filtered.map((p, i) => [p.slug, i]))

      sceneEls.forEach((el, slug) => {
        const idx = filteredIndexMap.get(slug)
        if (idx === undefined) {
          el.classList.remove('is-active', 'is-before')
          el.classList.add('is-after')
          el.setAttribute('aria-hidden', 'true')
          return
        }
        el.classList.toggle('is-active', idx === currentIdx)
        el.classList.toggle('is-before', idx < currentIdx)
        el.classList.toggle('is-after', idx > currentIdx)
        el.setAttribute('aria-hidden', String(idx !== currentIdx))
      })

      railBtns.forEach((btn) => {
        const slug = btn.dataset.railSlug ?? ''
        const visible = filteredIndexMap.has(slug)
        btn.classList.toggle('is-hidden', !visible)
        btn.classList.toggle('is-active', slug === active.slug)
      })

      overviewCards.forEach((card) => {
        const slug = card.dataset.overviewSlug ?? ''
        const visible = filteredIndexMap.has(slug)
        card.classList.toggle('is-hidden', !visible)
        card.classList.toggle('is-active', slug === active.slug)
      })

      counterEl.textContent = `${currentIdx + 1} / ${filtered.length}`
      updateAmbient(active)
      targetHelixIdx = currentIdx

      if (pushUrl) {
        const url = new URL(window.location.href)
        url.searchParams.set('project', active.slug)
        if (selectedCategory !== 'All') {
          url.searchParams.set('category', selectedCategory)
        } else {
          url.searchParams.delete('category')
        }
        window.history.replaceState({}, '', url.toString())
      }
    }

    function goTo(idx: number) {
      if (!filtered.length) return
      currentIdx = ((idx % filtered.length) + filtered.length) % filtered.length
      renderActiveScene(true)
    }

    function applyCategory(category: string, preferredSlug?: string) {
      selectedCategory = category
      catBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.category === category))
      filtered =
        category === 'All'
          ? [...allProjects]
          : allProjects.filter((p) => p.category === category)

      const found = preferredSlug ? filtered.findIndex((p) => p.slug === preferredSlug) : -1
      currentIdx = found >= 0 ? found : 0
      renderActiveScene(true)
    }

    // Bind Controls
    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        applyCategory(btn.dataset.category ?? 'All', filtered[currentIdx]?.slug)
      })
    })

    railBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = filtered.findIndex((p) => p.slug === btn.dataset.railSlug)
        if (idx >= 0) goTo(idx)
      })
    })

    overviewCards.forEach((card) => {
      card.addEventListener('click', () => {
        const idx = filtered.findIndex((p) => p.slug === card.dataset.overviewSlug)
        if (idx >= 0) {
          goTo(idx)
          setOverview(false)
        }
      })
    })

    prevBtn.addEventListener('click', () => goTo(currentIdx - 1))
    nextBtn.addEventListener('click', () => goTo(currentIdx + 1))
    overviewBtn.addEventListener('click', () => setOverview(!overviewOpen))
    overviewClose.addEventListener('click', () => setOverview(false))

    // Wheel transitions cleanly between full-viewport project scenes (both mouse wheel & trackpad)
    const onWheel = (e: WheelEvent) => {
      if (overviewOpen || window.innerWidth <= 1024) return
      const activeScene = filtered[currentIdx] ? sceneEls.get(filtered[currentIdx].slug) : null
      if (activeScene && activeScene.scrollHeight > activeScene.clientHeight + 2) {
        const atTop = activeScene.scrollTop <= 1
        const atBottom =
          activeScene.scrollTop + activeScene.clientHeight >= activeScene.scrollHeight - 2
        if ((e.deltaY > 0 && !atBottom) || (e.deltaY < 0 && !atTop)) {
          return
        }
      }
      e.preventDefault()
      const now = performance.now()
      if (now < wheelCooldown) {
        wheelAccum = 0
        return
      }
      if (now - lastWheelAt > 180) {
        wheelAccum = 0
      }
      lastWheelAt = now
      wheelAccum += e.deltaY
      if (Math.abs(wheelAccum) >= 42) {
        const dir = wheelAccum > 0 ? 1 : -1
        wheelAccum = 0
        wheelCooldown = now + 480
        goTo(currentIdx + dir)
      }
    }

    const onKeyDown = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && overviewOpen) {
        setOverview(false)
        return
      }
      if (overviewOpen) return
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight' || e.key === 'j') {
        e.preventDefault()
        goTo(currentIdx + 1)
      } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft' || e.key === 'k') {
        e.preventDefault()
        goTo(currentIdx - 1)
      }
    }

    // Touch swipe support on mobile/tablet
    let touchStartX = 0
    let touchStartY = 0
    const onTouchStart = (e: TouchEvent) => {
      if (overviewOpen || e.touches.length !== 1) return
      touchStartX = e.touches[0].clientX
      touchStartY = e.touches[0].clientY
    }
    const onTouchEnd = (e: TouchEvent) => {
      if (overviewOpen || e.changedTouches.length !== 1) return
      const dx = e.changedTouches[0].clientX - touchStartX
      const dy = e.changedTouches[0].clientY - touchStartY
      if (Math.abs(dx) > 56 && Math.abs(dx) > Math.abs(dy) * 1.4) {
        goTo(currentIdx + (dx < 0 ? 1 : -1))
      }
    }

    const onThemeChange = () => {
      if (filtered[currentIdx]) updateAmbient(filtered[currentIdx])
      drawParticlesFrame()
    }

    // Architectural 3D Orbital Gyroscope & Twin-Helix Contour Backdrop (spins smoothly on scroll!)
    const canvas = document.getElementById('projects-particle-canvas') as HTMLCanvasElement
    const ctx = canvas.getContext('2d')!

    let targetMx = 0
    let targetMy = 0
    let mx = 0
    let my = 0

    const onPointerMove = (e: PointerEvent) => {
      targetMx = (e.clientX / window.innerWidth - 0.5) * 2
      targetMy = (e.clientY / window.innerHeight - 0.5) * 2
    }

    const resizeCanvas = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      canvas.width = Math.round(canvas.clientWidth * dpr)
      canvas.height = Math.round(canvas.clientHeight * dpr)
    }
    resizeCanvas()

    let rafId = 0
    let t = 0

    const hexToRgbTuple = (hex: string): string => {
      const clean = hex.replace('#', '')
      if (clean.length !== 6) return '120,145,180'
      const r = parseInt(clean.slice(0, 2), 16)
      const g = parseInt(clean.slice(2, 4), 16)
      const b = parseInt(clean.slice(4, 6), 16)
      return Number.isNaN(r) ? '120,145,180' : `${r},${g},${b}`
    }

    const drawParticlesFrame = () => {
      const w = canvas.width
      const h = canvas.height
      const dpr = Math.min(window.devicePixelRatio || 1, 2)
      ctx.clearRect(0, 0, w, h)

      const isDark = document.documentElement.classList.contains('dark')
      const ink = isDark ? '240,240,240' : '18,18,18'
      const activeProj = filtered[currentIdx]
      const accentRgb = activeProj ? hexToRgbTuple(activeProj.gradientFrom) : '120,145,180'

      const cx = w * 0.5 + mx * 22 * dpr
      const cy = h * 0.5 + my * 14 * dpr
      const baseR = Math.min(w, h) * 0.44
      const spin = smoothHelixIdx * 0.85 + t

      const project3D = (x: number, y: number, z: number): [number, number, number] => {
        const persp = 2.65 / (3.85 - z)
        return [cx + x * baseR * persp, cy + y * baseR * persp, z]
      }

      const drawTiltedRing = (
        radius: number,
        tiltX: number,
        tiltZ: number,
        yaw: number,
        rgb: string,
        baseAlpha: number,
        widthScale: number,
        withTicks: boolean
      ) => {
        const segs = 120
        const cosX = Math.cos(tiltX), sinX = Math.sin(tiltX)
        const cosZ = Math.cos(tiltZ), sinZ = Math.sin(tiltZ)
        const cosY = Math.cos(yaw), sinY = Math.sin(yaw)

        const evalPt = (a: number): [number, number, number] => {
          const lx = Math.cos(a) * radius
          const lz = Math.sin(a) * radius
          // Yaw around Y
          const yx = lx * cosY + lz * sinY
          const yz = -lx * sinY + lz * cosY
          // Tilt around X
          const xy = -yz * sinX
          const xz = yz * cosX
          // Tilt around Z
          const zx = yx * cosZ - xy * sinZ
          const zy = yx * sinZ + xy * cosZ
          return project3D(zx, zy, xz)
        }

        // Draw smooth depth-modulated hairline segments
        ctx.lineWidth = widthScale * dpr
        let prev = evalPt(0)
        for (let s = 1; s <= segs; s++) {
          const cur = evalPt((s / segs) * Math.PI * 2)
          const depth = Math.max(0, Math.min(1, (cur[2] + 1.4) / 2.8))
          const alpha = baseAlpha * (0.28 + depth * 0.92)
          ctx.strokeStyle = `rgba(${rgb}, ${alpha.toFixed(3)})`
          ctx.beginPath()
          ctx.moveTo(prev[0], prev[1])
          ctx.lineTo(cur[0], cur[1])
          ctx.stroke()
          prev = cur
        }

        // Crisp architectural dial ticks & micro-nodes anchored right on the ring
        if (withTicks) {
          const tickCount = 24
          for (let k = 0; k < tickCount; k++) {
            const a = (k / tickCount) * Math.PI * 2
            const p0 = evalPt(a)
            const depth = Math.max(0, Math.min(1, (p0[2] + 1.4) / 2.8))
            const isMajor = k % 6 === 0
            if (isMajor) {
              const rNode = (2.1 + depth * 1.4) * dpr
              ctx.fillStyle = `rgba(${accentRgb}, ${(0.24 + depth * 0.42).toFixed(3)})`
              ctx.beginPath()
              ctx.arc(p0[0], p0[1], rNode, 0, Math.PI * 2)
              ctx.fill()
            } else {
              const rTick = (1.0 + depth * 0.6) * dpr
              ctx.fillStyle = `rgba(${rgb}, ${(baseAlpha * (0.55 + depth * 0.7)).toFixed(3)})`
              ctx.beginPath()
              ctx.arc(p0[0], p0[1], rTick, 0, Math.PI * 2)
              ctx.fill()
            }
          }
        }
      }

      // 3 Sculptural Counter-Rotating Orbital Rings (smooth 3D gyroscope spin on project change!)
      drawTiltedRing(1.34, 1.12 + my * 0.08, -0.24 + mx * 0.06, spin * 0.65, ink, isDark ? 0.11 : 0.09, 1.0, true)
      drawTiltedRing(1.06, 0.74 - my * 0.06, 0.42 - mx * 0.05, -spin * 0.48 + 0.9, accentRgb, isDark ? 0.17 : 0.14, 1.15, false)
      drawTiltedRing(1.62, 1.32 + my * 0.04, 0.14, spin * 0.32 + 2.1, ink, isDark ? 0.065 : 0.055, 0.85, false)

      // Sleek Architectural Twin-Helix Contour Spine (preserves the iconic scroll+spin rhythm!)
      const helixSteps = 96
      const hRadius = 0.86
      const hHeight = 2.05
      for (let strand = 0; strand < 2; strand++) {
        const phase = strand * Math.PI
        ctx.lineWidth = (strand === 0 ? 1.05 : 0.85) * dpr
        let prevH: [number, number, number] | null = null
        for (let s = 0; s <= helixSteps; s++) {
          const f = s / helixSteps
          const a = f * Math.PI * 3.6 + spin * 0.95 + phase
          const hx = Math.sin(a) * hRadius
          const hz = Math.cos(a) * hRadius
          const hy = (f - 0.5) * hHeight
          const pt = project3D(hx, hy, hz)
          if (prevH) {
            const edgeFade = Math.sin(f * Math.PI)
            const depth = Math.max(0, Math.min(1, (pt[2] + 1.1) / 2.2))
            const alpha = edgeFade * (0.04 + depth * (isDark ? 0.11 : 0.09))
            ctx.strokeStyle = strand === 0
              ? `rgba(${ink}, ${alpha.toFixed(3)})`
              : `rgba(${accentRgb}, ${(alpha * 1.25).toFixed(3)})`
            ctx.beginPath()
            ctx.moveTo(prevH[0], prevH[1])
            ctx.lineTo(pt[0], pt[1])
            ctx.stroke()
          }
          prevH = pt
        }
      }

      // Subtle architectural cross-rungs linking the twin helix curves
      const rungCount = 14
      ctx.lineWidth = 0.75 * dpr
      for (let k = 1; k < rungCount; k++) {
        const f = k / rungCount
        const a = f * Math.PI * 3.6 + spin * 0.95
        const hy = (f - 0.5) * hHeight
        const pA = project3D(Math.sin(a) * hRadius, hy, Math.cos(a) * hRadius)
        const pB = project3D(-Math.sin(a) * hRadius, hy, -Math.cos(a) * hRadius)
        const edgeFade = Math.sin(f * Math.PI)
        const alpha = edgeFade * (isDark ? 0.055 : 0.045)
        ctx.strokeStyle = `rgba(${ink}, ${alpha.toFixed(3)})`
        ctx.beginPath()
        ctx.moveTo(pA[0], pA[1])
        ctx.lineTo(pB[0], pB[1])
        ctx.stroke()
      }
    }

    const renderParticles = () => {
      t += 0.0045
      smoothHelixIdx += (targetHelixIdx - smoothHelixIdx) * 0.075
      mx += (targetMx - mx) * 0.05
      my += (targetMy - my) * 0.05

      drawParticlesFrame()
      rafId = requestAnimationFrame(renderParticles)
    }

    // Parse initial URL query (?project=<slug>&category=<cat>)
    const params = new URLSearchParams(window.location.search)
    const initialCat = params.get('category')
    const initialProj = params.get('project')
    let matchedCat = 'All'
    if (initialCat) {
      const btn = catBtns.find(
        (b) => (b.dataset.category ?? '').toLowerCase() === initialCat.toLowerCase()
      )
      if (btn?.dataset.category) matchedCat = btn.dataset.category
    }
    applyCategory(matchedCat, initialProj ?? undefined)
    smoothHelixIdx = targetHelixIdx

    window.addEventListener('wheel', onWheel, { passive: false })
    window.addEventListener('keydown', onKeyDown)
    window.addEventListener('pointermove', onPointerMove, { passive: true })
    window.addEventListener('resize', resizeCanvas, { passive: true })
    window.addEventListener('norb:theme-change', onThemeChange)
    app.addEventListener('touchstart', onTouchStart, { passive: true })
    app.addEventListener('touchend', onTouchEnd, { passive: true })

    rafId = requestAnimationFrame(renderParticles)

    cleanupProjects = () => {
      cancelAnimationFrame(rafId)
      window.removeEventListener('wheel', onWheel)
      window.removeEventListener('keydown', onKeyDown)
      window.removeEventListener('pointermove', onPointerMove)
      window.removeEventListener('resize', resizeCanvas)
      window.removeEventListener('norb:theme-change', onThemeChange)
      app.removeEventListener('touchstart', onTouchStart)
      app.removeEventListener('touchend', onTouchEnd)
    }
  }

  document.addEventListener('astro:before-swap', () => {
    if (cleanupProjects) {
      cleanupProjects()
      cleanupProjects = null
    }
  })

  document.addEventListener('astro:page-load', initProjectsStage)
</script>
